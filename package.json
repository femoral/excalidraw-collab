{
  "name": "excalidraw-collab",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "clean": "node --eval \"const{rmSync}=require('node:fs');for(const p of['packages/core','packages/server','packages/cli','packages/render','packages/web']){rmSync(p+'/dist',{recursive:true,force:true});rmSync(p+'/tsconfig.tsbuildinfo',{force:true})}\"",
    "dev": "pnpm -r --parallel run dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
