{
  "name": "@excalidraw-collab/cli",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "excalicli": "./bin/excalicli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node --eval \"const{rmSync}=require('node:fs');rmSync('dist',{recursive:true,force:true});rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc -b",
    "test": "node --test dist/**/*.test.js",
    "dev": "tsc -b --watch",
    "generate-cli-ref": "node ./scripts/generate-cli-ref.mjs"
  },
  "dependencies": {
    "@excalidraw-collab/core": "workspace:*"
  },
  "devDependencies": {
    "@excalidraw-collab/server": "workspace:*"
  }
}

